# Salin ke .env lalu isi. Jangan pernah commit .env.

# --- Database (XAMPP MariaDB, 127.0.0.1) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hadirin_dev
DB_TEST_NAME=hadirin_test
DB_APP_USER=hadirin
# Kata sandi pengguna aplikasi. Buat sendiri, unik, jangan pakai root.
DB_APP_PASSWORD=1234
# Dipakai hanya oleh `pnpm db:setup`. Biarkan kosong; skrip akan menanyakan bila perlu.
DB_ROOT_USER=root

# --- Aplikasi ---
API_PORT=4000
WEB_PORT=3000
COOKIE_SECURE=false

# --- Seed: kata sandi akun demo (admin, guru1, siswa pertama; harus berbeda). Orang tua tanpa kata sandi. ---
# Zona waktu sekolah (nama IANA). Tidak ditulis di kode.
SCHOOL_TIMEZONE=Asia/Jakarta

SEED_ADMIN_PASSWORD=12345678
SEED_TEACHER_PASSWORD=12345678
SEED_STUDENT_PASSWORD=12345678
# Kunci enkripsi qr_secret (32 byte, base64). Dipakai mulai Fase 3.
QR_SECRET_ENC_KEY=11zr4CEb9MOqFz+Gr7+aINil1boJKegUhU0jh0aXpxU=

# --- Autentikasi (Fase 2) ---
# Kunci tanda tangan token akses (minimal 32 karakter acak).
JWT_ACCESS_SECRET=KMVvQUfCWYuOj1ONYehrtsbOc9RfWKmZ5nbb74OJJJsGWGu2QRvMk4f54gZGqDnN
# Pepper untuk hash identitas perangkat (SHA-256(deviceId + pepper)).
DEVICE_PEPPER=_OO8MaE6rjdCaj7SvycMP1JZ-koRqwje
# Asal web (tautan atur ulang kata sandi, pemeriksaan Origin). Dipisah koma bila lebih dari satu.
APP_ORIGIN=http://localhost:3000
REFRESH_TTL_DAYS=14
# Email admin pertama untuk `pnpm db:create-admin`.
ADMIN_EMAIL=admin@hadirin.test
